# Contact form delivery — set ONE of these in the Vercel dashboard
# (Project → Settings → Environment Variables), then redeploy.
#
# Option A — Resend (https://resend.com, free tier available)
RESEND_API_KEY=
CONTACT_TO_EMAIL=anamikaya0908@gmail.com
# Must be a sender Resend has verified. onboarding@resend.dev works out of
# the box for delivery to the address that owns the Resend account.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Option B — any webhook (Formspree, Zapier, Make, Apps Script…)
# CONTACT_WEBHOOK_URL=
